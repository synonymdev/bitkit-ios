# Apple Push Notification Service Configuration
APN_KEY_ID=your_key_id_here
APN_TEAM_ID=your_team_id_here
APN_KEY_FILE=./AuthKey_your_key_id_here.p8
APN_PRODUCTION=false

# App Configuration
APP_BUNDLE_ID=to.bitkit

# Optional: the device token to relay pushes for (defaults to the newest recorded push)
DEVICE_TOKEN=

# Optional: the fake APNs of the wake gateway's docker stack
FAKE_PUSH_URL=http://127.0.0.1:9100
